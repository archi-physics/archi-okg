# CDS connector — CERN Document Server records over OAI-PMH.
#
# Off by default, like every optional source in this bundle: rename to
# cds.yaml to enable. It needs no credential — the OAI endpoint is
# public — but it does take a few minutes to harvest, so a bundle that
# installs it by default would slow every first build.
#
# The sets below are CMS's. Another experiment's instance sets its own;
# `verb=ListSets` on the endpoint lists what exists.
#
# Note on why this is OAI and not the search API: CDS's search and REST
# endpoints sit behind an anti-bot interstitial and answer HTTP 200 with
# HTML where JSON is expected. The connector's preflight detects that
# shape and fails loudly rather than parsing an interstitial as an empty
# corpus.
cds:
  module: archi.sources.cds
  class: CDSAdapter
  ownership_id: ${deployment_name}.cds
  admission_policy:
    producer_id: ${deployment_name}.cds
    producer_kind: source
    trust_label: implicit_legacy_trusted
    admission_mode: fast_track
    authority_scope:
      source_family: cern-team
      source_name: cds
    output_signature:
      nodes:
        - {subtype: cds_record}
      edges: []
    output_scope_summary:
      summary: CERN Document Server records for the configured OAI sets
      nodes: [cds_record]
      edges: []
  source_class: discovery_crawl
  record_identity_kind: scoped_locator
  record_identity_fields: [oai_id]
  source_revision_kind: content_hash
  deletion_semantics: missing_from_completed_scope
  publication_mode: published_generation
  required_for_baseline: false
  params:
    sets:
      - cerncds:cms-pas
      - cerncds:cms-notes
    required: false
    # Bound the harvest while trying it out. Unset harvests the sets
    # whole; a bounded run never claims complete scope.
    # max_records: 200
  sync:
    triggers: [manual, reconcile]
    default_event_mode: scope_complete
    reconcile_mode: scope_complete
